# SPDX-License-Identifier: GPL-2.0-only
# Native NVIDIA open modules profile; merge after aphrody-bun.config.
# WSL uses Microsoft's dxgkrnl and must not use this PCI driver profile.
CONFIG_MODULES=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_MMU_NOTIFIER=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_HMM_MIRROR=y
CONFIG_APHRODY_NVIDIA_HMM=y
# NVIDIA open modules own the GPU; competing in-tree drivers stay disabled.
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_NOVA is not set
# CONFIG_NOVA_CORE is not set
