# SPDX-License-Identifier: GPL-2.0-only
# Aphrody Alpine/Bun configuration, ported from aports d1c52dc3aee.
CONFIG_BUN_ACCEL=m
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_EXTENDED_MODVERSIONS=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_CONFIGFS_FS=m
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_VSOCKETS=m
# Aphrody Alpine kernel config fragment (system and Rust), merged on top of Alpine 3.24
# lts.<arch>.config (savedefconfig format, so anything absent from lts takes the Kconfig default)
# by scripts/kconfig/merge_config.sh, before bun.config (Bun-serving options), then
# `make LLVM=1 olddefconfig`. No option is set in both fragments.
#
# Format: justification comments, then the option. A line "# @arch <arch...>" right before an
# option restricts it to those CARCH values (x86_64, aarch64); the APKBUILD filters on it.
# Lines starting "# CONFIG_" are Kconfig "is not set" lines, not comments.
# After olddefconfig the APKBUILD compares every requested line with the final .config and
# warns about options the Kconfig dependencies refused (APHRODY_STRICT_CONFIG=1 makes it fatal).

# ---- Rust (Documentation/rust/quick-start.rst) --------------------------------------------
# Toolchain (scripts/min-tool-version.sh in 6.18: rustc 1.78.0, bindgen 0.65.1, LLVM 15.0.0):
# Alpine 3.24 rust 1.96.1 + rust-src, rust-bindgen 0.72.1, clang/lld/llvm 22; the APKBUILD
# runs `make LLVM=1 rustavailable` before olddefconfig.
# Rust support: Rust drivers below and out-of-tree Rust modules (Aphrody fork aphrody-labs/linux).
CONFIG_RUST=y
# RUST requires !MODVERSIONS || GENDWARFKSYMS; lts keeps MODVERSIONS=y, so symbol versions come
# from DWARF (needs DEBUG_INFO, no LTO; pahole 1.30 is outside the 1.28-1.29 x86 BTF exclusion).
CONFIG_GENDWARFKSYMS=y
# RUST requires !RANDSTRUCT.
CONFIG_RANDSTRUCT_NONE=y
# Release Rust code: no overflow checks or debug assertions in the hot paths.
# CONFIG_RUST_OVERFLOW_CHECKS is not set
# CONFIG_RUST_DEBUG_ASSERTIONS is not set
# CONFIG_RUST_BUILD_ASSERT_ALLOW is not set
# Kernel doctests are test-only.
# CONFIG_RUST_KERNEL_DOCTESTS is not set
# Firmware loader abstractions: required by nova-core.
CONFIG_RUST_FW_LOADER_ABSTRACTIONS=y
# PHY abstractions: Rust PHY drivers (the only in-tree user is the AX88796B reference driver,
# not enabled: lts has no AX88796B_PHY).
CONFIG_RUST_PHYLIB_ABSTRACTIONS=y
# DRM panic screen (lts: off) with the Rust QR code encoder: panic logs readable from a phone.
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
# Nova: Rust driver for NVIDIA GSP GPUs (Turing+). Modules, loaded only on matching hardware.
# DRM_NOVA needs DRM=y, which only x86_64 lts has (aarch64 lts: DRM=m).
CONFIG_NOVA_CORE=m
# @arch x86_64
CONFIG_DRM_NOVA=m
# Rust null block device (configfs): test target for Rust block code from the fork.
CONFIG_BLK_DEV_RUST_NULL=m
# Rust cpufreq-dt driver for device-tree arm64 boards.
# @arch aarch64
CONFIG_CPUFREQ_DT_RUST=m
# Not enabled: ANDROID_BINDER_IPC_RUST (Android only), DRM_TYR (needs DRM=y on aarch64),
# AX88796B_RUST_PHY (reference driver for a USB-Ethernet PHY absent from lts).

# ---- BPF LSM and LSM order ----------------------------------------------------------------
# BTF for modules too, so CO-RE works against module types (Rust CUs excluded by pahole >= 1.24).
CONFIG_DEBUG_INFO_BTF_MODULES=y
# BPF LSM hook (also requires "bpf" in CONFIG_LSM, set below): security policy in eBPF.
CONFIG_BPF_LSM=y
# kprobe/uprobe/tracepoint BPF attachment (implied by BPF_SYSCALL + tracing, no prompt).
CONFIG_BPF_EVENTS=y
# LSM framework.
CONFIG_SECURITY=y
# Initialisation order: landlock first (as in lts), "bpf" appended so BPF_LSM is active.
# "capability" is always implicit.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,bpf"

# ---- cgroups v2 (controllers beyond the ones in bun.config) ------------------------------
# RT group scheduling must be off: with it on, the v2 cpu controller cannot be enabled
# on groups containing RT tasks.
# CONFIG_RT_GROUP_SCHED is not set
# cpuacct statistics (cpu.stat, legacy cpuacct for v1 tools).
CONFIG_CGROUP_CPUACCT=y
# io.cost.* model-based IO control (better than io.max for mixed workloads).
CONFIG_BLK_CGROUP_IOCOST=y
# freezer: cgroup.freeze (checkpoint, pause containers).
CONFIG_CGROUP_FREEZER=y
# device controller (v1 devices cgroup; v2 uses CGROUP_BPF device programs).
CONFIG_CGROUP_DEVICE=y
# hugetlb controller: limits for hugepages per group.
CONFIG_CGROUP_HUGETLB=y
# rdma controller: limits RDMA/IB resources per group.
CONFIG_CGROUP_RDMA=y
# misc controller: scalar resources such as SEV ASIDs, SGX EPC.
CONFIG_CGROUP_MISC=y
# Pressure Stall Information: cgroup pressure files, systemd-oomd/earlyoom, load shedding.
CONFIG_PSI=y

# ---- KVM / vhost -------------------------------------------------------------------------
# x86 hypervisor core, module (as lts) so the vendor backend loads on demand. x86 only.
# @arch x86_64
CONFIG_KVM=m
# Intel VT-x backend. x86 only.
# @arch x86_64
CONFIG_KVM_INTEL=m
# AMD SVM backend. x86 only.
# @arch x86_64
CONFIG_KVM_AMD=m
# arm64 KVM is built in (arm64 has no Intel/AMD backends). arm64 only.
# @arch aarch64
CONFIG_KVM=y
# In-kernel virtio-net backend for QEMU/firecracker guests.
CONFIG_VHOST_NET=m
# vsock backend for guests (host<->guest channel, firecracker, kata).
CONFIG_VHOST_VSOCK=m

# ---- virtiofs / DAX ----------------------------------------------------------------------
# Shared host directories in VMs (virtiofsd), fast file sharing without 9p.
CONFIG_VIRTIO_FS=m
# DAX window for virtiofs (page cache bypass). Needs FS_DAX/DAX below; only effective
# where FS_DAX can be enabled (x86_64 in lts); the final check warns if refused elsewhere.
CONFIG_FUSE_DAX=y
# DAX infrastructure required by FUSE_DAX.
CONFIG_DAX=y
CONFIG_FS_DAX=y

# ---- zram --------------------------------------------------------------------------------
# Compressed RAM block device for swap on workstations (module, loaded by aphrody-sysctl).
CONFIG_ZRAM=m
# zstd backend for zram (separate Kconfig symbol since 6.15; needed for the default below).
CONFIG_ZRAM_BACKEND_ZSTD=y
# Default zram algorithm zstd: best ratio at acceptable speed.
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# Allocator used by zram and zswap.
CONFIG_ZSMALLOC=y
# Crypto API zstd, used by zswap and by crypto-based compression.
CONFIG_CRYPTO_ZSTD=y

# ---- tracing -----------------------------------------------------------------------------
# Tracing infrastructure and function tracer (ftrace, trace-cmd, perf trace).
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# ---- modules -----------------------------------------------------------------------------
# Loadable modules.
CONFIG_MODULES=y
# Compress modules (lts: on, gzip by default).
CONFIG_MODULE_COMPRESS=y
# zstd instead of gzip: smaller and faster to decompress (kmod and mkinitfs in Alpine handle
# .ko.zst; check before changing the initramfs tool).
CONFIG_MODULE_COMPRESS_ZSTD=y

# ---- kexec -------------------------------------------------------------------------------
# kexec_load(2) (kexec-tools); the Alpine patch 0003 adds the kexec_load_disabled boot option.
CONFIG_KEXEC=y
# kexec_file_load(2): fast kernel reboot, kdump, signature-verifiable loading. x86_64 and arm64.
CONFIG_KEXEC_FILE=y

# Bun-serving kernel options for linux-aphrody (Linux 7.2), merged after the Alpine lts
# config and config-aphrody.fragment by scripts/kconfig/merge_config.sh (see APKBUILD).
# One line per option: the Bun or JavaScriptCore API it serves. "# @arch <arch...>" before an
# option restricts it to those CARCH values. Symbol names checked against the inherited v6.18 Kconfig files; validate with 7.2 olddefconfig.
# Checked at runtime by aphrody/kernel/check-config.ts (reads /proc/config.gz).
#
# Not Kconfig options in 6.18 (always built in, nothing to set): pidfd_open/pidfd_send_signal,
# clone3, futex_waitv (FUTEX2 API, under FUTEX), TCP Fast Open, SO_REUSEPORT, UDP GSO/GRO,
# copy_file_range, FICLONE reflink ioctl, memfd_create (MEMFD_CREATE is selected, no prompt).
# Absent from 6.18: X86_64_VERSION (out-of-tree patch); the v3 flavor uses KCFLAGS instead.
# Perf JIT maps: no kernel option; JSC writes /tmp/perf-<pid>.map itself.

# ---- compiler and runtime debug ---------------------------------------------------------
# -O2 kernel: every syscall Bun makes (read/write/epoll/io_uring) runs optimised code.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# Lock debugging off: futex/mutex paths used by Bun's thread pool and JSC GC threads stay fast.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_LOCKDEP is not set
# Preempt-count checks off: no extra cost on every spinlock taken for Bun's syscalls.
# CONFIG_DEBUG_PREEMPT is not set
# KASAN off: no shadow-memory cost on mimalloc page faults and JSC heap growth.
# CONFIG_KASAN is not set
# SLUB debugging not on by default: kernel allocations behind sockets and fds stay fast.
# CONFIG_SLUB_DEBUG_ON is not set
# Page poisoning off: page frees behind mimalloc/JSC munmap and MADV_DONTNEED cost nothing extra.
# CONFIG_PAGE_POISONING is not set
# Page table checks off: no cost on mmap/mprotect of JSC JIT pages.
# CONFIG_PAGE_TABLE_CHECK is not set

# ---- scheduler and latency --------------------------------------------------------------
# Preemption model chosen at boot (preempt=none|voluntary|full|lazy): one image for servers and desktops.
CONFIG_PREEMPT_DYNAMIC=y
# Default model full: low wakeup latency for Bun.serve handlers and the event loop.
CONFIG_PREEMPT=y
# 1000 Hz tick: finer timer resolution for setTimeout/Bun.sleep and bun --watch.
CONFIG_HZ_1000=y
# Tickless CPUs on demand (nohz_full=): isolated cores for benchmark runs of Bun and bun test.
CONFIG_NO_HZ_FULL=y
# sched_ext: BPF schedulers (scx_*) tunable for Bun worker/event-loop threads (needs DEBUG_INFO_BTF).
CONFIG_SCHED_CLASS_EXT=y
# Per-session autogroups: a long bun build in a terminal does not starve the desktop.
CONFIG_SCHED_AUTOGROUP=y

# ---- asynchronous I/O -------------------------------------------------------------------
# io_uring: bun:linux ioUring.probe() and future io_uring I/O in Bun; never disabled by sysctl.
CONFIG_IO_URING=y
# futex: JSC/WTF locks, Atomics.wait, worker_threads and Bun's thread pool (also futex_waitv).
CONFIG_FUTEX=y
# Priority-inheritance futexes: pthread PI mutexes used by native addons via N-API.
CONFIG_FUTEX_PI=y
# eventfd: usockets/libuv wakeups of Bun's event loop from other threads.
CONFIG_EVENTFD=y
# timerfd: event loop timers (setTimeout, setInterval, Bun.serve idle timeouts).
CONFIG_TIMERFD=y
# signalfd: process.on("SIGINT"...) and Bun.spawn child exit notifications.
CONFIG_SIGNALFD=y
# epoll: the core of Bun's event loop on Linux (usockets).
CONFIG_EPOLL=y
# POSIX AIO (io_submit): native addons and databases embedded through bun:ffi.
CONFIG_AIO=y

# ---- memory (mimalloc, JSC GC) ----------------------------------------------------------
# Transparent huge pages: mimalloc and the JSC heap can opt in with MADV_HUGEPAGE.
CONFIG_TRANSPARENT_HUGEPAGE=y
# THP policy madvise: only regions that ask (mimalloc/JSC) get huge pages, no global bloat.
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# MGLRU: better reclaim under memory pressure for large JSC heaps and bun install caches.
CONFIG_LRU_GEN=y
# MGLRU on by default.
CONFIG_LRU_GEN_ENABLED=y
# zswap: compressed swap cache, cheaper than evicting JSC heap pages to disk.
CONFIG_ZSWAP=y
# zswap enabled at boot.
CONFIG_ZSWAP_DEFAULT_ON=y
# zstd compressor for zswap: good ratio on JS heap pages.
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
# userfaultfd: post-copy live migration and snapshotting of Bun processes (CRIU).
CONFIG_USERFAULTFD=y
# memfd_create: bun:linux memfd.create(), Bun's in-memory files and JSC executable memory.
CONFIG_MEMFD_CREATE=y
# memfd_secret: bun:linux secrets kept out of the kernel direct map (keys, tokens).
CONFIG_SECRETMEM=y
# Contiguous memory allocator: huge page and device buffers on large-memory servers.
CONFIG_CMA=y
# NUMA: mimalloc and Bun worker memory local to the CPU on multi-socket servers.
CONFIG_NUMA=y
# Automatic NUMA balancing: moves Bun worker pages next to the CPU that uses them.
CONFIG_NUMA_BALANCING=y
CONFIG_NUMA_BALANCING_DEFAULT_ENABLED=y
# KSM built in, off at runtime (/sys/kernel/mm/ksm/run=0 by default): no scanning of JSC heaps.
CONFIG_KSM=y

# ---- processes (Bun.spawn, bun:linux) ---------------------------------------------------
# CRIU interfaces (kcmp, /proc/<pid>/map_files, PR_SET_MM): cost-free unless used.
CONFIG_CHECKPOINT_RESTORE=y
# Namespaces: bun:linux unshare()/setns()/clone flags and Bun.spawn sandboxes.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_TIME_NS=y
# cgroups v2: bun:linux cgroup.* and Bun.spawn({ cgroup }) limits.
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
# seccomp filters: sandboxes around Bun.spawn children.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Landlock: bun:linux landlock.* unprivileged filesystem/network sandboxing.
CONFIG_SECURITY_LANDLOCK=y
# eBPF: profiling Bun (bpftrace, perf), sched_ext and cgroup BPF.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y

# ---- network (Bun.serve, fetch, HTTP/3) -------------------------------------------------
# BBR built in and default: throughput and latency of Bun.serve responses and fetch() downloads.
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# fq qdisc built in and default: pacing required by BBR.
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# kTLS (module, autoloaded by TCP_ULP "tls"): TLS record offload for Bun TLS sockets.
CONFIG_TLS=m
# kTLS NIC offload where the hardware supports it.
CONFIG_TLS_DEVICE=y
# AF_XDP sockets: zero-copy packet I/O for userspace QUIC stacks.
CONFIG_XDP_SOCKETS=y
# SO_BUSY_POLL: lower receive latency for Bun.serve under load (no prompt, default y).
CONFIG_NET_RX_BUSY_POLL=y
# IPv6: Bun.serve and fetch dual stack, Happy Eyeballs in Bun's DNS.
CONFIG_IPV6=y

# ---- files (fs.watch, bun install) ------------------------------------------------------
# inotify: fs.watch, bun --watch and bun --hot.
CONFIG_INOTIFY_USER=y
# fanotify: whole-mount watching for tools built on Bun.
CONFIG_FANOTIFY=y
# overlayfs: container layers of Bun images.
CONFIG_OVERLAY_FS=m
# Btrfs: FICLONE reflinks for bun install --backend=clonefile.
CONFIG_BTRFS_FS=m
# XFS: reflinks (FICLONE) for bun install on XFS too.
CONFIG_XFS_FS=m
# ext4: default root filesystem (module as lts, loaded by mkinitfs); copy_file_range for bun install --backend=copyfile.
CONFIG_EXT4_FS=m
# fs-verity: integrity of read-only Bun binaries and caches.
CONFIG_FS_VERITY=y
# FUSE: user filesystems mounted from Bun processes.
CONFIG_FUSE_FS=m

# ---- profiling (perf, bpftrace, JSC JIT) ------------------------------------------------
# perf_event_open: perf record of Bun (with JSC /tmp/perf-<pid>.map for JIT frames).
CONFIG_PERF_EVENTS=y
# /proc/config.gz: aphrody/kernel/check-config.ts reads the running config.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Kernel symbols in perf/bpftrace stacks of Bun syscalls.
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# uprobes: bpftrace/perf probes on Bun and JSC functions (USDT, uprobe:bun:*).
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
# kprobes: tracing kernel paths hit by Bun (tcp_sendmsg, io_uring).
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
# BTF: CO-RE BPF tools (bpftrace, scx schedulers) without kernel headers.
CONFIG_DEBUG_INFO_BTF=y
# ORC unwinder: reliable kernel stacks in perf profiles of Bun, without frame pointer cost.
# @arch x86_64
CONFIG_UNWINDER_ORC=y
# arm64 always unwinds with frame pointers (selected by the arch).
# @arch aarch64
CONFIG_FRAME_POINTER=y

# ---- security without throughput loss ---------------------------------------------------
# Hardened usercopy off: no bounds check on every copy_to/from_user of Bun's read/write.
# CONFIG_HARDENED_USERCOPY is not set
# No zeroing of every allocation: page faults for mimalloc/JSC heap growth stay cheap.
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
# CPU mitigations kept (Spectre/Meltdown defaults); no mitigations=off on the command line.
CONFIG_CPU_MITIGATIONS=y
